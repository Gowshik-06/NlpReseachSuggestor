# Copy this file to .env and adjust values for your local setup.
# Never commit the real .env file.

APP_NAME=research-paper-recommender
APP_VERSION=0.1.0
ENVIRONMENT=development

# When running via `docker compose up`, the backend container reaches
# Postgres at host "postgres". When running the backend directly on your
# machine (outside Docker), use "localhost" instead.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/research_papers

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

LOG_LEVEL=INFO
 
# --- AI Providers & Local-First Intelligence ---
# Set to true to enable LLM generation; if false, system runs in deterministic NLP mode.
RESEARCHLENS_AI_ENABLED=false
# Selection mode: 'local_first' (Ollama -> Groq -> Deterministic), 'groq_only', or 'deterministic_only'
RESEARCHLENS_AI_PROVIDER=local_first
# If local Ollama is unavailable, fallback to Groq if key is present
RESEARCHLENS_AI_CLOUD_FALLBACK=true
# Local Ollama configuration
RESEARCHLENS_OLLAMA_BASE_URL=http://127.0.0.1:11434
RESEARCHLENS_OLLAMA_MODEL=qwen2.5:3b
# Collaborator Groq configuration (each collaborator sets their own key; NEVER commit real keys)
GROQ_API_KEY=
RESEARCHLENS_GROQ_MODEL=llama-3.3-70b-versatile
# Limits & timeouts
RESEARCHLENS_AI_TIMEOUT_SECONDS=15.0
RESEARCHLENS_AI_MAX_OUTPUT_TOKENS=1024
RESEARCHLENS_AI_MAX_CONCURRENT_REQUESTS=4
# Cloud privacy protection: when false, private research content/PDFs will NOT be sent to Groq
RESEARCHLENS_ALLOW_CLOUD_RESEARCH_CONTENT=false

# --- Firebase Authentication (Backend) ---
# Set to true to require Firebase ID token verification
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: path to service account JSON credentials for Admin SDK
FIREBASE_CREDENTIALS_PATH=

# --- Firebase Web Configuration (Frontend / Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

