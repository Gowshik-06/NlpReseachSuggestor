# =================================================================
# ResearchLens Frontend — Vercel / Production Environment Example
# In Vercel, set these in Project Settings -> Environment Variables.
# NEVER commit real production secrets or API keys.
# =================================================================

# Production Backend API URL (without trailing slash)
VITE_API_BASE_URL=https://api.yourdomain.com

# Firebase Web Client Configuration (Public Web Client SDK credentials)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
