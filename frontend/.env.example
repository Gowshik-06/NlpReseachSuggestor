# =================================================================
# ResearchLens Frontend — Environment Configuration Template
# 
# For Vercel: Set in Project Settings -> Environment Variables.
# For Local Dev: Copy to frontend/.env or root .env
# NEVER commit real production secrets or API keys.
# =================================================================

# --- Backend API Connection ---
# For Local Development / Hybrid Laptop Backend:
# VITE_API_BASE_URL=http://localhost:8000
# For Full Cloud Production (Render/Fly/Railway Backend):
# VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8000

# --- Firebase Web Client SDK Configuration (Public Client Credentials) ---
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
